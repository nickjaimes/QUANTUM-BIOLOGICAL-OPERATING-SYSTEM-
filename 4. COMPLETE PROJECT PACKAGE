        neuron = self.neurons[neuron_id]
        last_spike = neuron.get('last_spike_time', -1.0)
        
        if last_spike > 0:
            # Calculate instantaneous firing rate
            interval = spike_time - last_spike
            if interval > 0:
                instantaneous_rate = 1000.0 / interval  # Convert to Hz
                
                # Exponential moving average
                neuron['firing_rate'] = (
                    0.9 * neuron.get('firing_rate', 0.0) + 
                    0.1 * instantaneous_rate
                )
    
