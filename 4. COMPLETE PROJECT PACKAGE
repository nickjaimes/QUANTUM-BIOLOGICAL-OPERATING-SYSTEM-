            try:
                # Get next spike (priority queue by timestamp)
                priority, spike = self.spike_queue.get_nowait()
                
                # Check if spike time has arrived
                if spike.timestamp <= current_time:
                    # Deliver spike to post-synaptic neurons
                    self._deliver_spike(spike)
                
                else:
                    # Put back in queue
