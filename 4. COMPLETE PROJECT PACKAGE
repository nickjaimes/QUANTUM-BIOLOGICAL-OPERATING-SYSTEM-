        threat_type = outcome.get('threat_type')
        success = outcome.get('success', False)
        
        if threat_type:
            # Update threat database
            if threat_type not in self.threat_database['known_threats']:
                self.threat_database['known_threats'][threat_type] = {
                    'count': 0,
                    'success_rate': 0.0,
