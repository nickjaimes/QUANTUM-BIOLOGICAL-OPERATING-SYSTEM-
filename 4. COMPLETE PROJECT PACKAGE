        current_time = time.time() * 1000  # ms
        
        for neuron in self.neurons:
            neuron_type = neuron['type']
            
            if neuron_type == NeuronType.LIF:
                self._update_lif_neuron(neuron, current_time)
            elif neuron_type == NeuronType.IZH:
