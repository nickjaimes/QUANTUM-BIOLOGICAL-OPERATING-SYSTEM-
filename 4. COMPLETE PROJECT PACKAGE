            threat_data['count'] += 1
            threat_data['last_seen'] = time.time()
            
            # Update success rate
            old_rate = threat_data['success_rate']
            old_count = threat_data['count'] - 1
            new_rate = ((old_rate * old_count) + (1 if success else 0)) / threat_data['count']
            threat_data['success_rate'] = new_rate
            
            # Update detector sensitivity based on outcome
            if success:
