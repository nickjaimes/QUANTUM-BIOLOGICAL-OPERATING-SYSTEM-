        # Find all synapses where this neuron is pre-synaptic
        for synapse in self.synapses:
            if synapse.pre_neuron == neuron_id:
                # Calculate delivery time
                delivery_time = spike.timestamp + synapse.delay
                
                # Create post-synaptic spike
                post_spike = Spike(
                    neuron_id=synapse.post_neuron,
                    timestamp=delivery_time,
                    amplitude=spike.amplitude * synapse.weight,
                    source=f"synapse_{synapse.pre_neuron}_{synapse.post_neuron}"
                )
                
                # Queue post-synaptic spike
                self.spike_queue.put((delivery_time, post_spike))
                
                # Update STDP traces for pre-synaptic neuron
                if synapse.plasticity == 'stdp':
                    self.neurons[neuron_id]['stdp_trace_pre'] = (
                        self.neurons[neuron_id].get('stdp_trace_pre', 0.0) + 1.0
                    )
        
        # Update neuron's last spike time
        self.neurons[neuron_id]['last_spike_time'] = spike.timestamp
        
        # Update firing rate
