                cost += self.variables[var_name].weight * (error ** 2)
            
            # Add biological constraints cost
            cost += self.biological_constraint_cost(correction_vector)
            
            return cost
        
        # Convert to quantum oracle using phase kickback
        oracle = QuantumCircuit(self.num_qubits + 1)  # Extra qubit for phase
        
        # Encode cost function in phases
        for i in range(2 ** self.num_qubits):
            # Calculate cost for this correction combination
            correction = self.index_to_correction(i)
            cost = cost_function(correction)
            
            # Apply phase proportional to cost
            if cost > 0:
                phase = np.pi * cost / self.max_cost
                oracle.p(phase, self.num_qubits)  # Phase kickback
        
